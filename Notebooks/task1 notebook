          "name": "stdout",
          "text": [
            "missing values (total)                                      0\n",
            "duplicated rows                                             0\n",
            "runs without exactly 4032 steps                             0\n",
            "runs where step is not 0..4031                              0\n",
            "time gaps not equal to 5 min                                0\n",
            "pairs with different timestamp/occupancy/outside temp       0\n",
            "rows where reward != rc_agent_reward                        0\n",
            "constant cols (done, run_status, run_steps) not constant    0\n",
            "rows where run_id != building__weather__policy              0\n",
            "run_* columns with >1 value in a run                        0\n",
            "buildings with >1 value of run_n_zones                      0\n",
            "buildings with >1 value of run_n_floors                     0\n",
            "buildings with >1 value of run_n_ahus                       0\n",
            "Distinct buildings: 6\n"
          ]
        }
      ],
      "source": [
        "checks = {}\n",
        "g = df_raw.groupby(\"run_id\")\n",
        "\n",
        "# completeness\n",
        "checks[\"missing values (total)\"] = int(df_raw.isna().sum().sum())\n",
        "checks[\"duplicated rows\"] = int(df_raw.duplicated().sum())\n",
        "\n",
        "# run structure\n",
        "checks[\"runs without exactly 4032 steps\"] = int((g.size() != 4032).sum())\n",
        "checks[\"runs where step is not 0..4031\"] = int(\n",
        "    g.step.apply(lambda s: not (s.sort_values().to_numpy() == np.arange(4032)).all()).sum())\n",
        "ts = pd.to_datetime(df_raw.timestamp)\n",
        "gap = ts.groupby(df_raw.run_id).diff().dropna()\n",
        "checks[\"time gaps not equal to 5 min\"] = int((gap != pd.Timedelta(minutes=5)).sum())\n",
        "\n",
        "# the two policies share the same conditions within a (building, weather) pair\n",
        "shared = [\"timestamp\", \"occupancy\", \"outside_air_temp_K\"]\n",
        "bad_pairs = 0\n",
        "for _, p in df_raw.groupby([\"building\", \"weather\"]):\n",
        "    a = p[p.policy == \"pid_water\"].sort_values(\"step\")[shared].reset_index(drop=True)\n",
        "    b = p[p.policy == \"noisy_pid_water\"].sort_values(\"step\")[shared].reset_index(drop=True)\n",
        "    if not a.equals(b):\n",
        "        bad_pairs += 1\n",
        "checks[\"pairs with different timestamp/occupancy/outside temp\"] = bad_pairs\n",
        "\n",
        "# redundancy and constants\n",
        "checks[\"rows where reward != rc_agent_reward\"] = int((df_raw.reward != df_raw.rc_agent_reward).sum())\n",
        "checks[\"constant cols (done, run_status, run_steps) not constant\"] = int(\n",
        "    sum(df_raw[c].nunique() != 1 for c in [\"done\", \"run_status\", \"run_steps\"]))\n",
        "checks[\"rows where run_id != building__weather__policy\"] = int(\n",
        "    (df_raw.run_id != df_raw.building + \"__\" + df_raw.weather + \"__\" + df_raw.policy).sum())\n",
        "\n",
        "# run-level and building-level columns\n",
        "run_cols = [c for c in df_raw.columns if c.startswith(\"run_\") and c != \"run_id\"]\n",
        "checks[\"run_* columns with >1 value in a run\"] = int(sum((g[c].nunique() > 1).any() for c in run_cols))\n",
        "for c in [\"run_n_zones\", \"run_n_floors\", \"run_n_ahus\"]:\n",
        "    checks[f\"buildings with >1 value of {c}\"] = int((df_raw.groupby(\"building\")[c].nunique() > 1).sum())\n",
        "\n",
        "qc = pd.Series(checks, name=\"violations\")\n",
        "print(qc.to_string())\n",
        "print(\"Distinct buildings:\", df_raw.building.nunique())"
      ]
