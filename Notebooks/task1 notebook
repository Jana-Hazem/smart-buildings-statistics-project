        "def loop_count(event, given=None):\n",
        "    '''Route 3a: plain Python loop. P(event | given), or P(event) when given is None.'''\n",
        "    ev = event.to_numpy().tolist(); gv = None if given is None else given.to_numpy().tolist()\n",
        "    num = den = 0\n",
        "    for k in range(len(ev)):\n",
        "        if gv is None or gv[k]:\n",
        "            den += 1\n",
        "            if ev[k]: num += 1\n",
        "    return num / den\n",
        "\n",
        "def crosstab_cond(event, given):\n",
        "    '''Route 3b: P(event | given) read from a cross-tabulation (rows = given, columns = event).'''\n",
        "    t = pd.crosstab(given, event)\n",
        "    return t.loc[True, True] / t.loc[True].sum()\n",
        "\n",
        "OC = df.OCC & df.COLD\n",
