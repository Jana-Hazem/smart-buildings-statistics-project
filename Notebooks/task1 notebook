        "    (\"P(HP | OCC)\",         (df.OCC & df.HP).mean() / df.OCC.mean(), Pc(df.HP, df.OCC), crosstab_cond(df.HP, df.OCC)),\n",
        "    (\"P(HP | not OCC)\",     res_M3[\"P(HP | not OCC)\"],         Pc(df.HP, ~df.OCC),       crosstab_cond(df.HP, ~df.OCC)),\n",
        "    (\"P(HP | OCC and COLD)\", res_M3[\"P(HP | OCC and COLD)\"],   Pc(df.HP, OC),            loop_count(df.HP, OC)),\n",
        "    (\"P(OCC | HP)\",         post_occ,                          Pc(df.OCC, df.HP),        crosstab_cond(df.OCC, df.HP)),\n",
        "    (\"P(NOISY | HP)\",       post_noisy,                        Pc(df.NOISY, df.HP),      crosstab_cond(df.NOISY, df.HP)),\n",
