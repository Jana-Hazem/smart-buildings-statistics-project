        "def Pc(a, b):\n",
        "    '''P(a | b) for two Boolean Series: |a and b| / |b| (b = the condition).'''\n",
        "    return (a & b).sum() / b.sum()\n",
        "\n",
        "p_hp_all  = df.HP.mean()\n",
        "p_hp_occ  = Pc(df.HP, df.OCC)          # P(HP | occupied)\n",
        "p_hp_nocc = Pc(df.HP, ~df.OCC)         # P(HP | empty)\n",
        "print(f\"P(HP)            = {p_hp_all:.4f}\")\n",
        "print(f\"P(HP | OCC)      = {p_hp_occ:.4f}   (given people are present)\")\n",
        "print(f\"P(HP | not OCC)  = {p_hp_nocc:.4f}   (given the building is empty)\")\n",
        "print(f\"ratio            = {p_hp_occ / p_hp_nocc:.1f}x\")\n",
        "\n",
        "# independent route: groupby mean (no formula)\n",
        "gb = df.groupby(\"OCC\").HP.mean()\n",
        "assert np.isclose(gb[True], p_hp_occ) and np.isclose(gb[False], p_hp_nocc)\n",
        "\n",
        "# second condition: occupied AND cold vs occupied AND not cold\n",
        "p_hp_oc  = Pc(df.HP, df.OCC & df.COLD)\n",
        "p_hp_onc = Pc(df.HP, df.OCC & ~df.COLD)\n",
        "print(f\"\\nP(HP | OCC and COLD)     = {p_hp_oc:.4f}\")\n",
        "print(f\"P(HP | OCC and not COLD) = {p_hp_onc:.4f}\")\n",
        "\n",
        "# building size (3 big vs 3 small buildings)\n",
        "p_hp_big, p_hp_nbig = Pc(df.HP, df.BIG), Pc(df.HP, ~df.BIG)\n",
        "p_hp_occ_big, p_hp_occ_nbig = Pc(df.HP, df.OCC & df.BIG), Pc(df.HP, df.OCC & ~df.BIG)\n",
        "print(f\"\\nP(HP | BIG) = {p_hp_big:.4f}  vs  P(HP | not BIG) = {p_hp_nbig:.4f}\")\n",
        "print(f\"among occupied steps: BIG {p_hp_occ_big:.3f}  vs  not BIG {p_hp_occ_nbig:.3f}\")\n",
        "\n",
