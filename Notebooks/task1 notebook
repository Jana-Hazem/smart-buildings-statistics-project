        "print(f\"\\nC) city posterior (sums to {post_city.sum():.4f}):\"); display(city_post.round(4))\n",
        "\n",
        "# D) building characteristics\n",
        "p_hp_f4 = Pc(df.HP, df.F4); p_hp_big_ = Pc(df.HP, df.BIG)\n",
