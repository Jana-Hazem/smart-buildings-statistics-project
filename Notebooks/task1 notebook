        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "rng4 = np.random.default_rng(42)\n",
        "R_BOOT = 2000\n",
        "\n",
        "# Day-block ids: one block = one run on one day (60 runs x 14 days = 840 blocks)\n",
        "blk_codes, blk_names = pd.factorize(df.run_id + \"|\" + df.day.astype(str))\n",
        "N_BLK = len(blk_names)\n",
        "\n",
        "def independence_band(a, b, cond=None, R=R_BOOT):\n",
        "    \"\"\"Difference P(A and B) - P(A)P(B), with a 95% day-block bootstrap band.\"\"\"\n",
        "    m = np.ones(len(df), dtype=bool) if cond is None else np.asarray(cond)\n",
        "    a = np.asarray(a) & m\n",
        "    b = np.asarray(b) & m\n",
        "\n",
        "    # Per block: n in the condition, n_A, n_B, and n_(A and B)\n",
        "    cols = [m, a, b, a & b]\n",
        "    cnt = np.column_stack([\n",
        "        np.bincount(blk_codes, weights=c.astype(float), minlength=N_BLK)\n",
        "        for c in cols\n",
        "    ])\n",
        "\n",
        "    def independence_difference(t):\n",
        "        n = t[..., 0]\n",
        "        p_a = t[..., 1] / n\n",
        "        p_b = t[..., 2] / n\n",
        "        p_ab = t[..., 3] / n\n",
        "        return p_ab - p_a * p_b\n",
        "\n",
        "    # Resample whole run-day blocks to retain within-day dependence\n",
        "    idx = rng4.integers(0, N_BLK, (R, N_BLK))\n",
        "    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n",
        "        boot = independence_difference(cnt[idx].sum(axis=1))\n",
        "    lo, hi = np.nanpercentile(boot, [2.5, 97.5])\n",
        "\n",
        "    tot = cnt.sum(axis=0)\n",
        "    p_a, p_b, p_ab = tot[1] / tot[0], tot[2] / tot[0], tot[3] / tot[0]\n",
        "    difference = p_ab - p_a * p_b\n",
        "    return {\n",
        "        \"P(A)P(B)\": p_a * p_b,\n",
        "        \"P(A and B)\": p_ab,\n",
        "        \"difference\": difference,\n",
        "        \"band_lo\": lo,\n",
        "        \"band_hi\": hi\n",
        "    }\n",
        "\n",
        "b0 = sorted(df.building.unique())[0]\n",
        "B2 = df.building == b0\n",
        "pairs = [  # (name, A, B, condition)\n",
        "    (\"OCC vs NOISY\",                df.OCC,   df.NOISY, None),\n",
        "    (\"COLD vs NOISY\",               df.COLD,  df.NOISY, None),\n",
        "    (\"OCC vs HP\",                   df.OCC,   df.HP,    None),\n",
        "    (\"NOISY vs HP\",                 df.NOISY, df.HP,    None),\n",
        "    (\"OCC vs COLD\",                 df.OCC,   df.COLD,  None),\n",
        "    (\"COLD vs HP\",                  df.COLD,  df.HP,    None),\n",
        "    (\"OCC vs HE (high elec. cost)\", df.OCC,  df.HE,    None),\n",
        "    (f\"{b0} vs OCC\",                B2,       df.OCC,   None),\n",
        "    (\"BIG vs NOISY\",                df.BIG,   df.NOISY, None),\n",
        "    (\"BIG vs OCC\",                  df.BIG,   df.OCC,   None),\n",
        "    (\"BIG vs HP\",                   df.BIG,   df.HP,    None),\n",
        "    (\"F4 vs HP\",                    df.F4,    df.HP,    None),\n",
        "    (\"NOISY vs HP | OCC\",           df.NOISY, df.HP,    df.OCC),\n",
        "    (\"NOISY vs HP | not OCC\",       df.NOISY, df.HP,    ~df.OCC),\n",
        "]\n",
        "\n",
        "rows = []\n",
        "for name, a, b, cond in pairs:\n",
        "    r = independence_band(a, b, cond)\n",
        "    r[\"pair\"] = name\n",
        "    r[\"verdict\"] = (\n",
        "        \"consistent with independence\"\n",
        "        if r[\"band_lo\"] <= 0 <= r[\"band_hi\"]\n",
        "        else (\"positive dependence\" if r[\"difference\"] > 0 else \"negative dependence\")\n",
        "    )\n",
        "    rows.append(r)\n",
        "\n",
        "ind = pd.DataFrame(rows).set_index(\"pair\")[\n",
        "    [\"P(A)P(B)\", \"P(A and B)\", \"difference\", \"band_lo\", \"band_hi\", \"verdict\"]\n",
        "]\n",
        "ind.round(4)\n"
      ]
