      "source": [
        "rng6 = np.random.default_rng(42)\n",
        "occ = df[df.OCC]\n",
        "n_occ, p_hat = len(occ), occ.HP.mean()\n",
        "R = 2000\n",
        "\n",
        "# (1) naive row-level: equivalent to resampling occupied rows independently (binomial draw)\n",
        "naive = rng6.binomial(n_occ, p_hat, R) / n_occ\n",
        "\n",
        "# (2) day-block: resample run-days that have occupied steps\n",
        "gd = occ.groupby([\"run_id\", \"day\"]).HP.agg([\"size\", \"sum\"]).to_numpy()\n",
        "ix = rng6.integers(0, len(gd), (R, len(gd)))\n",
        "dayb = gd[ix, 1].sum(1) / gd[ix, 0].sum(1)\n",
        "\n",
        "# (3) run-block: resample the 60 runs\n",
        "gr = occ.groupby(\"run_id\").HP.agg([\"size\", \"sum\"]).to_numpy()\n",
        "ix = rng6.integers(0, len(gr), (R, len(gr)))\n",
        "runb = gr[ix, 1].sum(1) / gr[ix, 0].sum(1)\n",
        "\n",
        "ci = pd.DataFrame({\"resampling unit\": [\"occupied rows (naive)\", f\"run-days ({len(gd)} blocks)\", f\"runs ({len(gr)} blocks)\"],\n",
        "                   \"lower\": [np.percentile(x, 2.5) for x in (naive, dayb, runb)],\n",
        "                   \"upper\": [np.percentile(x, 97.5) for x in (naive, dayb, runb)]})\n",
        "ci[\"width\"] = ci.upper - ci.lower\n",
        "print(f\"point estimate P(HP | OCC) = {p_hat:.4f}\")\n",
        "ci.round(4)"
      ]
    },
