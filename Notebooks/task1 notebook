        "def bayes(lik, prior, evidence):\n",
        "    '''P(H | E) = P(E | H) P(H) / P(E).'''\n",
        "    return lik * prior / evidence\n",
        "\n",
        "# A) occupancy and B) policy\n",
        "post_occ   = bayes(p_hp_occ, df.OCC.mean(), p_hp_all);   dir_occ   = Pc(df.OCC, df.HP)\n",
        "p_hp_noisy = Pc(df.HP, df.NOISY)\n",
        "post_noisy = bayes(p_hp_noisy, df.NOISY.mean(), p_hp_all); dir_noisy = Pc(df.NOISY, df.HP)\n",
        "print(f\"A) P(OCC | HP)   = {post_occ:.4f}  (direct {dir_occ:.4f})  prior {df.OCC.mean():.4f}\")\n",
        "print(f\"B) P(NOISY | HP) = {post_noisy:.4f}  (direct {dir_noisy:.4f})  prior {df.NOISY.mean():.4f}\")\n",
        "assert np.isclose(post_occ, dir_occ) and np.isclose(post_noisy, dir_noisy)\n",
        "\n",
        "# C) city posterior table (priors 0.2 each; denominator = total probability from 5.7)\n",
        "post_city = bayes(r_city, w_city, tp_city)\n",
        "dir_city  = df[df.HP].city.value_counts(normalize=True)\n",
        "city_post = pd.DataFrame({\"prior P(city)\": w_city, \"P(HP|city)\": r_city,\n",
