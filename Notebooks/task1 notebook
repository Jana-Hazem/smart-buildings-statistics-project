        "# threshold sensitivity: HP is defined as reward < t, an analyst choice\n",
        "th_rows = []\n",
        "for t in (-0.05, -0.1, -0.2):\n",
        "    hp = df.reward < t\n",
        "    th_rows.append({\"threshold\": t, \"P(HP)\": hp.mean(), \"P(HP | OCC)\": Pc(hp, df.OCC),\n",
        "                    \"P(HP | not OCC)\": Pc(hp, ~df.OCC),\n",
        "                    \"fairbanks > atlanta\": hp.groupby(df.city).mean()[\"fairbanks\"] > hp.groupby(df.city).mean()[\"atlanta\"],\n",
        "                    \"noisy > clean\": Pc(hp, df.NOISY) > Pc(hp, ~df.NOISY)})\n",
        "th_tab = pd.DataFrame(th_rows).set_index(\"threshold\")\n",
        "display(th_tab.round(4))\n",
        "\n",
        "# does the ORDERING of the main findings survive every preprocessing choice?\n",
        "def order_checks(d):\n",
        "    hp_c = d.HP.groupby(d.city).mean()\n",
        "    out = {\"occupied > empty\": Pc(d.HP, d.OCC) > Pc(d.HP, ~d.OCC)}\n",
        "    out[\"Fairbanks > Atlanta\"] = hp_c[\"fairbanks\"] > hp_c[\"atlanta\"] if {\"fairbanks\", \"atlanta\"} <= set(hp_c.index) else np.nan\n",
        "    out[\"Phoenix > Atlanta\"]   = hp_c[\"phoenix\"]   > hp_c[\"atlanta\"] if {\"phoenix\", \"atlanta\"} <= set(hp_c.index) else np.nan\n",
        "    out[\"noisy > clean\"]       = Pc(d.HP, d.NOISY) > Pc(d.HP, ~d.NOISY) if d.NOISY.any() and (~d.NOISY).any() else np.nan\n",
        "    return out\n",
        "robust = pd.DataFrame({\"full\": order_checks(df), \"trim\": order_checks(df_trim),\n",
        "                       \"no Fairbanks\": order_checks(df_no_fb), \"pid only\": order_checks(df_pid)})\n",
        "display(robust)"
