        "def total_prob(labels, event):\n",
        "    '''Total probability over a partition given by `labels`: sum_i P(event | group i) P(group i).'''\n",
        "    w = labels.value_counts(normalize=True)                  # P(group)\n",
        "    r = event.groupby(labels).mean()                         # P(event | group)\n",
        "    return (w * r).sum(), w, r\n",
        "\n",
        "parts = {\"city\": df.city, \"policy\": df.policy, \"floors\": df.run_n_floors, \"building\": df.building}\n",
        "rows = []\n",
        "for name, lab in parts.items():\n",
        "    tp, w, r = total_prob(lab, df.HP)\n",
        "    rows.append((name, len(w), tp, p_hp_all, abs(tp - p_hp_all)))\n",
        "    assert np.isclose(tp, p_hp_all)\n",
        "tp_tab = pd.DataFrame(rows, columns=[\"partition\", \"groups\", \"total probability\", \"direct P(HP)\", \"|difference|\"])\n",
        "display(tp_tab.round(6))\n",
        "\n",
        "# the city partition in detail (and the numbers used later as Bayes priors / likelihoods)\n",
        "tp_city, w_city, r_city = total_prob(df.city, df.HP)\n",
        "city_tab = pd.DataFrame({\"P(city)\": w_city, \"P(HP|city)\": r_city, \"product\": w_city * r_city}).round(4)\n",
        "print(\"sum of products =\", round(city_tab[\"product\"].sum(), 4)); display(city_tab)\n",
        "tp_pol, w_pol, r_pol = total_prob(df.policy, df.HP)\n",
        "tp_fl,  w_fl,  r_fl  = total_prob(df.run_n_floors, df.HP)\n",
        "print(\"policy:\", r_pol.round(4).to_dict(), \"| floors:\", r_fl.round(4).to_dict())"
      ]
