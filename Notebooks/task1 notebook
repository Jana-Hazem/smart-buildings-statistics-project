        "# (a) Mutually exclusive events with positive probability are dependent\n",
        "p_cold9 = df.COLD.mean()\n",
        "p_hot9 = df.HOT.mean()\n",
        "p_both9 = (df.COLD & df.HOT).mean()\n",
        "product_cold_hot9 = p_cold9 * p_hot9\n",
        "diff_cold_hot9 = p_both9 - product_cold_hot9\n",
        "\n",
        "print(\n",
        "    f\"P(COLD) = {p_cold9:.4f}  P(HOT) = {p_hot9:.4f}  \"\n",
        "    f\"P(COLD and HOT) = {p_both9:.4f}  \"\n",
        "    f\"vs  P(COLD)P(HOT) = {product_cold_hot9:.4f}\"\n",
        ")\n",
        "print(\n",
        "    f\"P(HOT | COLD) = {(df.HOT & df.COLD).sum() / df.COLD.sum():.4f}  \"\n",
        "    f\"vs  P(HOT) = {p_hot9:.4f}  \"\n",
        "    f\"-> difference P(COLD and HOT) - P(COLD)P(HOT) = {diff_cold_hot9:.4f}; dependent\"\n",
        ")\n",
        "assert p_both9 == 0 and product_cold_hot9 > 0\n",
        "\n",
        "\n",
        "# (b) Mutual independence of three events:\n",
        "# all three pairwise rules AND the three-event rule must hold\n",
        "def mutual_check(a, b, c, names):\n",
        "    pa, pb, pc = a.mean(), b.mean(), c.mean()\n",
        "    pab = (a & b).mean()\n",
        "    pac = (a & c).mean()\n",
        "    pbc = (b & c).mean()\n",
        "    pabc = (a & b & c).mean()\n",
        "\n",
        "    rows = {\n",
        "        f\"{names[0]} , {names[1]}\": (pab, pa * pb),\n",
        "        f\"{names[0]} , {names[2]}\": (pac, pa * pc),\n",
        "        f\"{names[1]} , {names[2]}\": (pbc, pb * pc),\n",
        "        \"all three\": (pabc, pa * pb * pc),\n",
        "    }\n",
        "\n",
        "    t = pd.DataFrame(rows, index=[\"P(joint)\", \"product of P\"]).T\n",
        "    t[\"difference\"] = t[\"P(joint)\"] - t[\"product of P\"]\n",
        "    t[\"product rule holds\"] = np.isclose(t[\"difference\"], 0.0)\n",
        "    return t\n",
        "\n",
        "\n",
        "mi_1 = mutual_check(df.OCC, df.COLD, df.NOISY, [\"OCC\", \"COLD\", \"NOISY\"])\n",
        "mi_2 = mutual_check(df.OCC, df.COLD, df.HP, [\"OCC\", \"COLD\", \"HP\"])\n",
